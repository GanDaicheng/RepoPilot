# Runtime data and managed Worktrees must live outside target repositories.
REPOPILOT_DATA_DIR=C:/replace-with-an-external-repopilot-data-directory

# DeepSeek (real smoke remains disabled by default).
DEEPSEEK_MODEL=replace-with-model-id
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-a-rotated-key
RUN_DEEPSEEK_SMOKE=0

# Qwen / Alibaba Cloud Model Studio OpenAI-compatible endpoint.
QWEN_MODEL=replace-with-model-id
QWEN_BASE_URL=https://replace-with-your-regional-compatible-endpoint/v1
DASHSCOPE_API_KEY=replace-with-a-rotated-key
RUN_QWEN_SMOKE=0

# Optional custom OpenAI-compatible provider.
MODEL_NAME=replace-with-model-id
MODEL_BASE_URL=https://replace-with-compatible-endpoint/v1
MODEL_API_KEY=replace-with-a-rotated-key
